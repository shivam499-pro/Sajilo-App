{
  "expo": {
    "name": "Sajilo_App",
    "slug": "Sajilo_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sajiloapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyATBhc1O9_tru6xdrrYxLmyjlFEgb3Tesg",
        "authDomain" : "sajilo-app-41ce5.firebaseapp.com",
        "projectId" : "sajilo-app-41ce5",
        "storageBucket" : "sajilo-app-41ce5.firebasestorage.app",
        "messagingSenderId": "1079866319176",
        "appId" : "1:1079866319176:web:358418e404a9b82e47937d"
      }
    },

    "ios": {
      "supportsTablet": true
    },
    
    "android": {
      "package": "com.sajilo.delivery",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
